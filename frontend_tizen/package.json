{
  "name": "tizen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "node ./scripts/vite-guard.js && node ./node_modules/vite/bin/vite.js",
    "build": "node ./scripts/vite-guard.js && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./scripts/vite-guard.js && node ./node_modules/vite/bin/vite.js preview",
    "lint": "eslint .",
    "package:tizen": "cd dist && zip -r ../app.wgt * ../config.xml"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "5.4.10"
  },
  "overrides": {
    "vite": "5.4.10",
    "vite@*": "5.4.10",
    "vite@^6": "5.4.10",
    "vite@^7": "5.4.10",
    "@vitejs/plugin-react": "4.3.4",
    "rollup": "4.24.0",
    "esbuild": "0.21.5"
  }
}
